{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SFTP Studio",
  "version": "1.0.0",
  "identifier": "com.sftpstudio.app",
  "build": { "frontendDist": "../src" },
  "app": {
    "windows": [{ "title": "SFTP Studio", "width": 1440, "height": 900, "minWidth": 1100, "minHeight": 700, "resizable": true }],
    "security": { "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "externalBin": ["binaries/sftp-legacy"]
  }
}
